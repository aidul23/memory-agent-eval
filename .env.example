# Copy this file to `.env` and fill in your credentials.
# All providers are optional; the platform falls back to a Mock LLM when keys are missing.

OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Local model server (Ollama) base URL
OLLAMA_BASE_URL=http://localhost:11434

# External memory providers (placeholders for future integration)
MEM0_API_KEY=
ZEP_API_URL=http://localhost:8000
ZEP_API_KEY=
SUPERMEMORY_API_KEY=
ACONTEXT_API_KEY=

# Misc
LOG_LEVEL=INFO
