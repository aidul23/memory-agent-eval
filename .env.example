# Copy this file to `.env` and fill in your credentials.
# All providers are optional; the platform falls back to a Mock LLM when keys are missing.

OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Local model server (Ollama) base URL
OLLAMA_BASE_URL=http://localhost:11434

# ---- External memory backends (self-hosted by default) ----
# Each wrapper falls back to a clearly-logged local stub when its server / SDK
# is unavailable. Bring up only the ones you want to compare.

# Mem0 (self-hosted, in-process library + vector store)
# Mem0 itself has no server; it uses Qdrant (or another vector store) and an LLM
# for memory extraction. With OPENAI_API_KEY above, the defaults work out of the box.
MEM0_VECTOR_STORE=qdrant
MEM0_QDRANT_URL=http://localhost:6333
MEM0_LLM_PROVIDER=openai
MEM0_LLM_MODEL=gpt-4o-mini

# Zep Community Edition (self-hosted via Docker compose, github.com/getzep/zep)
ZEP_API_URL=http://localhost:8000
ZEP_API_KEY=

# AContext (self-hosted via `acontext server up`, docs.acontext.io/settings/local)
ACONTEXT_API_URL=http://localhost:8029/api/v1
ACONTEXT_API_KEY=sk-ac-your-root-api-bearer-token

# Vectorize Hindsight (self-hosted via `docker run ... ghcr.io/vectorize-io/hindsight`)
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_LLM_PROVIDER=openai
HINDSIGHT_LLM_MODEL=gpt-4.1-mini

# Misc
LOG_LEVEL=INFO
